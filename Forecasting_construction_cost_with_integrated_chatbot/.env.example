# Copy to .env and fill in. .env is git-ignored; never commit real keys.
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Admin panel login
ADMIN_LOGIN=admin
ADMIN_PASSWORD=admin
# Optional: enables AI answers in the chatbot (https://aistudio.google.com/apikey)

# Claude powers chatbot answers beyond the built-in ones (https://console.anthropic.com)
ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-opus-5-5

# Free alternative, used when ANTHROPIC_API_KEY is empty (https://console.groq.com/keys)
GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-120b
